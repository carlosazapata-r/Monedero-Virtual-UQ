<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.monedero.controller.LoginController"
            style="-fx-background-color: linear-gradient(to bottom right, #6c5ce7, #74b9ff);">

    <center>
        <VBox spacing="12" alignment="CENTER"
              style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8;"
              BorderPane.alignment="CENTER">

            <Label text="Monedero Virtual"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <Label text="Usuario:"
                   style="-fx-font-size: 13px;"/>
            <TextField fx:id="txtUsuario"
                       promptText="Ej: Carlos"
                       style="-fx-pref-width: 220; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #4a90e2;"/>

            <Label text="Contraseña:"
                   style="-fx-font-size: 13px;"/>
            <PasswordField fx:id="txtPassword"
                           promptText="******"
                           style="-fx-pref-width: 220; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #4a90e2;"/>

            <Button text="Entrar / Registrar"
                    onAction="#onLogin"
                    style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 6 16 6 16;"/>

            <Label text="Si el usuario no existe, se registra con esa contraseña."
                   style="-fx-font-size: 10px; -fx-text-fill: #777777;"/>
        </VBox>
    </center>
</BorderPane>

