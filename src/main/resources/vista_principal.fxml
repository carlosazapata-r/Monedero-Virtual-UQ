<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.monedero.controller.PrincipalController"
            style="-fx-background-color: #f5f6fa;">

    <top>
        <ToolBar style="-fx-background-color: #dbe4f0; -fx-padding: 6;">
            <HBox spacing="30" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="6" left="10" right="10" bottom="6"/>
                </padding>

                <!-- Combo oculto que usa el controlador para guardar el cliente actual -->
                <ComboBox fx:id="comboClientes"
                          visible="false"
                          managed="false"/>

                <!-- BIENVENIDA -->
                <Label fx:id="lblBienvenido"
                       text="Bienvenido"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <!-- Separador visual -->
                <Separator orientation="VERTICAL" prefHeight="30"/>

                <!-- BLOQUE: MONEDERO ORIGEN -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Monedero origen:"/>
                    <ComboBox fx:id="comboMonederos"
                              onAction="#onMonederoSeleccionado"
                              prefWidth="170"/>
                </HBox>

                <!-- BLOQUE: CLIENTE DESTINO -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Cliente destino:"/>
                    <ComboBox fx:id="comboClientesDestino"
                              onAction="#onClienteDestinoSeleccionado"
                              prefWidth="150"/>
                </HBox>

                <!-- BLOQUE: MONEDERO DESTINO -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Monedero destino:"/>
                    <ComboBox fx:id="comboMonederosDestino"
                              prefWidth="170"/>
                </HBox>
            </HBox>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 15;">
            <!-- SECCIÓN: INFORMACIÓN DEL CLIENTE -->
            <TitledPane text="Información del cliente" expanded="true">
                <content>
                    <HBox spacing="30" style="-fx-padding: 10 0 10 10;">

                        <!-- SALDO -->
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Saldo:"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <Label fx:id="lblSaldo"
                                   text="0.0"
                                   style="-fx-font-size: 22px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- PUNTOS -->
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Puntos:"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <Label fx:id="lblPuntos"
                                   text="0"
                                   style="-fx-font-size: 18px; -fx-text-fill: #e67e22; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- RANGO -->
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Rango:"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <Label fx:id="lblRango"
                                   text="BRONCE"
                                   style="-fx-font-size: 18px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
                        </HBox>

                    </HBox>
                </content>
            </TitledPane>

            <!-- SECCIÓN: OPERACIONES -->
            <TitledPane text="Operaciones sobre el monedero" expanded="true">
                <content>
                    <VBox spacing="8" style="-fx-padding: 8 0 8 0;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Monto:"
                                   style="-fx-font-size: 13px;"/>
                            <TextField fx:id="txtMonto"
                                       promptText="Ingrese monto"
                                       style="-fx-pref-width: 140; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #4a90e2;"/>

                            <Button text="Depositar"
                                    onAction="#onDepositar"
                                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 4;"/>
                            <Button text="Retirar"
                                    onAction="#onRetirar"
                                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 4;"/>
                            <Button text="Transferir"
                                    onAction="#onTransferir"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="Canjear 100 pts" onAction="#onCanjear100"
                                    style="-fx-background-radius: 4;"/>
                            <Button text="Canjear 500 pts" onAction="#onCanjear500"
                                    style="-fx-background-radius: 4;"/>
                            <Button text="Canjear 1000 pts" onAction="#onCanjear1000"
                                    style="-fx-background-radius: 4;"/>
                            <Button text="Análisis de gastos" onAction="#onVerAnalisis"
                                    style="-fx-background-radius: 4;"/>
                            <Button text="Ordenar historial" onAction="#onOrdenarHistorial"
                                    style="-fx-background-radius: 4;"/>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>

            <!-- SECCIÓN: HISTORIAL -->
            <TitledPane text="Historial de transacciones" expanded="true">
                <content>
                    <VBox spacing="5" style="-fx-padding: 8 0 0 0;">
                        <TextArea fx:id="txtHistorial"
                                  prefRowCount="16"
                                  wrapText="true"
                                  style="-fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #cccccc;"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="Transacciones programadas" expanded="false">
                <content>
                    <VBox spacing="8" style="-fx-padding: 8;">
                        <HBox spacing="10">
                            <Label text="Tipo:"/>
                            <ComboBox fx:id="comboTipoProgramada" prefWidth="140"/>
                        </HBox>

                        <HBox spacing="10">
                            <Label text="Fecha ejecución:"/>
                            <DatePicker fx:id="datePickerProgramada"/>
                        </HBox>

                        <HBox spacing="10">
                            <CheckBox fx:id="checkRecurrente" text="Recurrente cada 30 días"/>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="Programar transacción"
                                    onAction="#onProgramarTransaccion"/>
                            <Button text="Procesar pendientes"
                                    onAction="#onProcesarTransacciones"/>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>

        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10"
              style="-fx-padding: 5 10 5 10;">

            <Label fx:id="lblEstado"
                   text=""
                   style="-fx-text-fill: #555555; -fx-font-size: 12px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Cerrar sesión"
                    onAction="#onLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4;"/>
        </HBox>
    </bottom>
</BorderPane>
